# The Hermes agent -- the orchestration layer generation and content
# validation route through (hermes_agent/app.py), per refinedversion.md. NOT
# the "Hermes-3-8B" model (OLLAMA_HERMES3_MODEL below) -- unrelated names; no
# Hermes model is loaded anywhere, the agent's underlying model is qwen3.5:4b.
# Run the agent as its own process: python -m hermes_agent.app
# It refuses to start without HERMES_AGENT_API_KEY set. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
HERMES_AGENT_URL=http://localhost:8100
HERMES_AGENT_API_KEY=changeme-generate-a-real-key
HERMES_AGENT_PORT=8100

# NETWORK_MODE: lan | wg | auto (auto tries lan first, then wg)
NETWORK_MODE=auto

# Which model the app generates with: qwen | hermes
# qwen3.5:4b is the active model -- it runs both the generation and the
# validation role in the study (see validation.md). Set to hermes to switch back.
MODEL_SELECTION=qwen

OLLAMA_LAN_URL=http://host-on-lan:11434
OLLAMA_WG_URL=http://host-on-wireguard:11434
# Optional: only needed if Qwen is served from a different host than Hermes.
# Falls back to the OLLAMA_* URLs above when unset.
QWEN_LAN_URL=http://host-on-lan:11434
QWEN_WG_URL=http://host-on-wireguard:11434

OLLAMA_QWEN3_MODEL=qwen3.5:4b
# Not called at present -- kept so MODEL_SELECTION=hermes still works.
OLLAMA_HERMES3_MODEL=hermes3:8b
OLLAMA_LLAMA3_MODEL=llama3:8b

OLLAMA_INPUT_COST_PER_1K_USD=0
OLLAMA_OUTPUT_COST_PER_1K_USD=0

# Students worked on at once. 0 = size the pool from live host capacity and grow
# it mid-run if capacity increases; any positive value pins it. On a CPU-only
# host concurrency measured 0.96x (no gain), so auto-detection reports one slot
# there. See docs/GPU_SETUP.md.
REPORT_WORKERS=0

# Queue-level retries. 0 = retry forever -- a failed student is requeued to the
# back rather than retried in place, so retrying indefinitely costs nobody else
# their turn. Set a positive number to bound it and make the fallback reachable.
REPORT_MAX_ATTEMPTS=0
REPORT_RETRY_BASE_DELAY_S=10
REPORT_RETRY_MAX_DELAY_S=300

# Quick attempts inside one queue turn before the task goes back to the queue.
OLLAMA_ATTEMPTS_PER_TURN=2

# Qwen is called directly via Ollama (core/ollama_client.py) -- there is no
# separate "Hermes agent" it routes through. What actually makes it "remember"
# across calls in a batch is this: Ollama keeps the model loaded and reuses its
# cached evaluation of the shared system prompt (schema + question bank, byte-
# identical for every student in a batch) instead of re-reading it from scratch
# each time. Unset/0 lets Ollama unload the model after ~5 min idle, which
# throws that cache away. Measured: this is what cut per-student generation
# time ~46%.
OLLAMA_KEEP_ALIVE=30m
# The prompt runs ~4,300 tokens; below 8192 Ollama silently truncates context
# rather than erroring.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.3

# Validation study only (app.py --mode agent|direct|both). Defaults to
# OLLAMA_QWEN3_MODEL's value if unset.
STUDY_MODEL=qwen3.5:4b
